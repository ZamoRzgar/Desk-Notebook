{
  "name": "desk-notebook",
  "version": "0.1.3",
  "private": true,
  "description": "A note-taking app that looks like a physical book — binder-tab sections, rich text, highlights, and tags.",
  "author": {
    "name": "ZamoRzgar",
    "email": "zamo.rzgar1@gmail.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "npm run build && electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.desknotebook.app",
    "productName": "Desk Notebook",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "publish": {
      "provider": "github",
      "owner": "ZamoRzgar",
      "repo": "Desk-Notebook"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Desk Notebook",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "category": "Utility;Office",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "synopsis": "A cozy book-style notebook",
      "description": "Desk Notebook — a note-taking app that looks like a physical book, with binder-tab sections, rich text, highlights, and tags."
    }
  }
}
