# better-sqlite3 downloads prebuilt binaries from GitHub Releases during
# npm install, which is unreachable on some networks (e.g. GitHub is proxied
# in China). npmmirror mirrors those release assets.
better_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/better-sqlite3

# Same for Electron downloads (used by electron-builder / install-app-deps).
electron_mirror=https://npmmirror.com/mirrors/electron/
